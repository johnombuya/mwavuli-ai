# Project Mwavuli Environment Configuration
# Copy this file to .env and fill in your values

# Firebase Configuration
# Path to your Firebase service account JSON (relative to backend/ or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Custom Firestore database ID (leave empty to use default database)
# If you created a custom database in Firebase Console, specify it here
FIREBASE_DATABASE_ID=mwavuli-nira-db

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Configuration (for WhatsApp integration via n8n)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

