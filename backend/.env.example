# Project Mwavuli Environment Configuration
# Copy this file to .env and fill in your values

# Firebase Configuration
# Path to your Firebase service account JSON (relative to backend/ or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Custom Firestore database ID (leave empty to use default database)
# If you created a custom database in Firebase Console, specify it here
FIREBASE_DATABASE_ID=mwavuli-nira-db

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Configuration (for WhatsApp integration via n8n)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Web ingestion and auto-reports (optional)
# Set INGESTION_ENABLED=true to run the ingestion pipeline (cron or script)
INGESTION_ENABLED=false
# Comma-separated RSS/Atom feed URLs (allowlisted only)
INGESTION_RSS_FEEDS=
# Comma-separated domains allowed for scraping (e.g. example.com)
INGESTION_SCRAPE_DOMAINS=
# Optional: comma-separated seed URLs to scrape (must be in INGESTION_SCRAPE_DOMAINS)
INGESTION_SCRAPE_SEED_URLS=
# Max requests per minute (polite default)
INGESTION_RATE_LIMIT_REQ_PER_MIN=30
# User-Agent sent with requests (identifiable for site owners)
INGESTION_USER_AGENT=MwavuliElectionMonitor/1.0
# Optional: comma-separated keywords to filter election-related content; empty = verify all
INGESTION_ELECTION_KEYWORDS=
# Optional: run identifier for audit logs
INGESTION_JOB_ID=
# Optional: enable GET /api/v1/ingestion/status for last run summary
INGESTION_ADMIN_ENABLED=false

# Alerts / early warning (optional)
# Webhook URL to POST when HIGH risk count in last 24h exceeds threshold
ALERT_WEBHOOK_URL=
# HIGH risk count threshold (default 10)
ALERT_HIGH_RISK_THRESHOLD=10

