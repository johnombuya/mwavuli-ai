# Project Mwavuli Environment Configuration
# Copy this file to .env and fill in your values

# -- Database provider --
# Options: firebase, supabase
DB_PROVIDER=supabase

# -- Firebase (required when DB_PROVIDER=firebase) --
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Custom Firestore database ID (leave empty for default database)
FIREBASE_DATABASE_ID=mwavuli-nira-db

# -- Supabase (required when DB_PROVIDER=supabase) --
# Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -- Google Gemini --
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Vision model for image verification (default: gemini-2.5-flash)
GEMINI_VISION_MODEL=gemini-2.5-flash

# -- Security and Privacy --
# Salt used when hashing sender IDs (prevents rainbow-table attacks)
SENDER_HASH_SALT=change_me_to_random_string
# Comma-separated API keys for authentication (empty = auth disabled)
API_KEYS=
# Comma-separated key:role pairs  e.g. key1:admin,key2:analyst,key3:viewer
API_KEY_ROLES=
# Days to retain report data before purge script deletes them (default 365)
DATA_RETENTION_DAYS=365

# -- Rate limiting --
# Max verify requests per sender hash within the sliding window
RATE_LIMIT_MAX=30
# Sliding window duration in seconds
RATE_LIMIT_WINDOW=60

# -- Alerts / early warning (optional) --
# Webhook URL to POST when HIGH risk count exceeds threshold
ALERT_WEBHOOK_URL=
# HIGH risk count threshold (default 10; halved automatically in emergency mode)
ALERT_HIGH_RISK_THRESHOLD=10
# Start in emergency mode (default false; toggle at runtime via API)
EMERGENCY_MODE=false

# -- Twilio WhatsApp (optional) --
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -- Africa's Talking SMS (optional) --
AT_USERNAME=
AT_API_KEY=

# -- Local LLM fallback (optional) --
LOCAL_LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -- Ensemble weights --
ENSEMBLE_W_LEXICON=0.35
ENSEMBLE_W_DETOXIFY=0.25
ENSEMBLE_W_KENYAN=0.20
ENSEMBLE_W_GEMINI=0.20

# -- Queue processing (optional, requires Redis) --
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# -- Web ingestion (optional) --
INGESTION_ENABLED=false
INGESTION_RSS_FEEDS=
INGESTION_SCRAPE_DOMAINS=
INGESTION_SCRAPE_SEED_URLS=
INGESTION_RATE_LIMIT_REQ_PER_MIN=30
INGESTION_USER_AGENT=MwavuliElectionMonitor/1.0
INGESTION_ELECTION_KEYWORDS=
INGESTION_JOB_ID=
INGESTION_ADMIN_ENABLED=false

# -- Multi-sector lexicon (optional) --
# Path to CSV for custom lexicon entries
MWAVULI_LEXICON_CSV_PATH=

# -- CORS (production) --
FRONTEND_URL=http://localhost:3000
